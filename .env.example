DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/agenticcrm?schema=public"

# Only needed when DATABASE_URL is a pooled connection (Neon's `-pooler` host,
# Supabase's port 6543) -- migrations need a direct connection instead, since
# advisory locking isn't reliable over a transaction-mode pooler. Leave unset
# for a plain local Postgres like the default above.
# DIRECT_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/agenticcrm?schema=public"

# Signing key for the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
